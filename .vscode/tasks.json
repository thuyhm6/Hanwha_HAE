{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile: javac (WEB-INF/classes)",
            "type": "shell",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\compile.ps1"],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Tomcat: Start (JPDA debug)",
            "type": "shell",
            "command": "catalina.bat",
            "args": ["jpda", "start"],
            "options": {
                "cwd": "D:\\Java\\apache-tomcat\\bin",
                "env": {
                    "CATALINA_HOME": "D:\\Java\\apache-tomcat",
                    "CATALINA_BASE": "D:\\Java\\apache-tomcat",
                    "JAVA_HOME": "C:\\Program Files\\Java\\jdk1.8.0_231",
                    "JPDA_ADDRESS": "8000",
                    "JPDA_TRANSPORT": "dt_socket"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Tomcat: Stop",
            "type": "shell",
            "command": "catalina.bat",
            "args": ["stop"],
            "options": {
                "cwd": "D:\\Java\\apache-tomcat\\bin",
                "env": {
                    "CATALINA_HOME": "D:\\Java\\apache-tomcat",
                    "CATALINA_BASE": "D:\\Java\\apache-tomcat",
                    "JAVA_HOME": "C:\\Program Files\\Java\\jdk1.8.0_231"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]
}
