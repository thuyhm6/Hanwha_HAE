	<select id="getHrPersonDeptList" parameterClass="linkMap"
		resultClass="linkMap" remapResults="true">
			<![CDATA[
			SELECT parent_dept_name,
       dept_name,
       GROUP_FLAG,
       ORDER_NOS,
       SUM(YESTERDAY_CNT) YESTERDAY_CNT,
       SUM(TODAY_CNT) TODAY_CNT

  FROM (SELECT parent_dept_name,
               dept_name,
                GROUP_FLAG,
               ORDER_NOS,
               0 YESTERDAY_CNT,
               COUNT(*) TODAY_CNT
        
          from (SELECT HD.ORG_NAME_LOCAL DEPT_NAME,
                       hdn.org_name_local parent_dept_name,
                       hd.ORDER_NOS,
                       HE.PERSON_ID,
                       (select TT.deptno
                          FROM hr_department TT　
                         WHERE TT.CPNY_ID = 'TSTO'
                           and tt.DEPT_LEVEL = 2
                           and rownum = 1
                          START WITH TT.DEPTNO = HE.DEPTNO
                        CONNECT BY PRIOR TT.PARENT_DEPT_NO = TT.DEPTNO 　) GROUP_FLAG
                  FROM HR_EMPLOYEE HE,
                       (SELECT hd1.*, ROWNUM ORDER_NOS
                          FROM HR_DEPARTMENT hd1
                         WHERE hd1.CPNY_ID = 'TSTO'
                         START WITH hd1.PARENT_DEPT_NO = '0'
                        CONNECT BY PRIOR hd1.DEPTNO = hd1.PARENT_DEPT_NO
                         ORDER SIBLINGS BY hd1.ORDERNO) HD,
                       HR_DEPARTMENT HDN
                 WHERE HE.CPNY_ID = 'TSTO'
                   AND HE.DEPTNO = HD.DEPTNO
                   AND TO_CHAR(HE.DATE_STARTED, 'YYYY/MM/DD') <=
                       TO_CHAR(TO_DATE(#TO_DATE#, 'YYYY/MM/DD'), 'YYYY/MM/DD')
                   AND (HE.DATE_LEFT IS NULL OR
                       TO_CHAR(HE.DATE_LEFT, 'YYYY/MM/DD') >
                       TO_CHAR(TO_DATE(#TO_DATE#, 'YYYY/MM/DD'),
                                'YYYY/MM/DD'))
                   AND HE.EMPID NOT LIKE '111111%'
                      
                   AND HE.EMP_TYPE_CODE <> '10418'
                      
                   and hd.parent_dept_no = hdn.deptno(+)
                
                 group by HE.EMP_TYPE_CODE,
                          HE.DEPTNO,
                          HD.ORG_NAME_LOCAL,
                          hdn.org_name_local,
                          HD.ORDER_NOS,
                          HE.PERSON_ID) tt
         group by parent_dept_name, ORDER_NOS, dept_name, GROUP_FLAG
        
        union all
        
        SELECT parent_dept_name,
               dept_name,
               GROUP_FLAG,
               ORDER_NOS,
               COUNT(*) YESTERDAY_CNT,
               0 TODAY_CNT
        
          from (SELECT HD.ORG_NAME_LOCAL DEPT_NAME,
                       hdn.org_name_local parent_dept_name,
                       hd.ORDER_NOS,
                       HE.PERSON_ID,
                       (select TT.deptno
                          FROM hr_department TT　
                         WHERE TT.CPNY_ID = 'TSTO'
                           and tt.DEPT_LEVEL = 2
                           and rownum = 1
                        
                         START WITH TT.DEPTNO = HE.DEPTNO
                        CONNECT BY PRIOR TT.PARENT_DEPT_NO = TT.DEPTNO 　) GROUP_FLAG
                  FROM HR_EMPLOYEE HE,
                       (SELECT hd1.*, ROWNUM ORDER_NOS
                          FROM HR_DEPARTMENT hd1
                         WHERE hd1.CPNY_ID = 'TSTO'
                         START WITH hd1.PARENT_DEPT_NO = '0'
                        CONNECT BY PRIOR hd1.DEPTNO = hd1.PARENT_DEPT_NO
                         ORDER SIBLINGS BY hd1.ORDERNO) HD,
                       HR_DEPARTMENT HDN
                 WHERE HE.CPNY_ID = 'TSTO'
                   AND HE.DEPTNO = HD.DEPTNO
                   AND TO_CHAR(HE.DATE_STARTED, 'YYYY/MM/DD') <=
                       TO_CHAR(TO_DATE(#FROM_DATE#, 'YYYY/MM/DD'),
                               'YYYY/MM/DD')
                   AND (HE.DATE_LEFT IS NULL OR
                       TO_CHAR(HE.DATE_LEFT, 'YYYY/MM/DD') >
                       TO_CHAR(TO_DATE(#FROM_DATE#, 'YYYY/MM/DD'),
                                'YYYY/MM/DD'))
                   AND HE.EMPID NOT LIKE '111111%'
                   AND HE.EMP_TYPE_CODE <> '10418'
                      
                   and hd.parent_dept_no = hdn.deptno(+)
                
                 group by HE.EMP_TYPE_CODE,
                          HE.DEPTNO,
                          HD.ORG_NAME_LOCAL,
                          hdn.org_name_local,
                          HD.ORDER_NOS,
                          HE.PERSON_ID) tt
         group by parent_dept_name, ORDER_NOS, dept_name, GROUP_FLAG
        
        )

 group by parent_dept_name, ORDER_NOS, dept_name, GROUP_FLAG

          
			]]>
	</select>
</sqlMap>