<sqlMap namespace="report.ar">

	<!--
		SELECT T.CODE_NO, T.DESCRIPTION, T.DEPTH, T.ORDERNO, T.PARENT_CODE_NO,
		NVL(U.CONTENT,' ') CONTENT FROM SY_CODE T, SY_GLOBAL_NAME U WHERE
		T.CODE_NO = U.NO(+) AND U.LANGUAGE(+)=#interLanguage:VARCHAR# AND
		T.ACTIVITY = 1 START WITH T.CODE_NO=#PARENT_CODE_NO:NUMERIC# CONNECT
		BY PRIOR T.CODE_NO = T.PARENT_CODE_NO ORDER SIBLINGS BY T.ORDERNO
	-->
	<select id="getCodeListByParentCode" parameterClass="linkMap"
		resultClass="linkMap" remapResults="true">
		<![CDATA[
		     SELECT T.CODE_NO,
			        NVL(U.CONTENT, ' ') AS CONTENT,
			        T.DEPTH,
			        T.PARENT_CODE_NO,
			        get_global_name(T.CODE_NO,'ko') KO,
              		get_global_name(T.CODE_NO,'en') EN,
              		T.Orderno ORDERNO
			   FROM SY_CODE T, SY_GLOBAL_NAME U
			  WHERE U.NO(+) = T.CODE_NO
			    AND U.LANGUAGE(+) = #interLanguage:VARCHAR#
			    AND T.ACTIVITY = 1
			  START WITH T.PARENT_CODE_NO = #PARENT_CODE_NO:NUMERIC#
			 CONNECT BY PRIOR T.CODE_NO = T.PARENT_CODE_NO
			  ORDER SIBLINGS BY T.ORDERNO
		]]>
	</select>
	<select id="getreportList" parameterClass="linkMap" resultClass="linkMap"
		remapResults="true">
			<![CDATA[
			    SELECT get_global_name(C.REPORT_NO, #interLanguage:VARCHAR#) REPORT_CONTENT,
				       C.ORDERNO,
				       C.REPORT_TYPE_NO,
				       C.URL_JSP
				  FROM REPORT_CENTER C
				 WHERE C.ACTIVITY = '1'
				AND C.CPNY_ID=#CPNY#
				 ORDER BY C.REPORT_TYPE_NO, C.ORDERNO
			]]>
	</select>

	<select id="getArCodeNameByCode" parameterClass="linkMap"
		resultClass="linkMap" remapResults="true">
			<![CDATA[
			   SELECT DISTINCT(AR.CODE_NO),
			   SY.CONTENT AS CODE_NAME 
			   FROM 
			      (SELECT AL.LEAVE_TYPE_CODE AS CODE_NO FROM ESS_LEAVE_APPLY_TB AL 
			       UNION ALL SELECT ALB.LEAVE_TYPE_CODE AS CODE_NO FROM ESS_LEAVE_APPLY_TB_BATCH ALB 
			       UNION ALL SELECT OT.OT_TYPE_CODE AS CODE_NO FROM ESS_APPLY_OT OT 
			       UNION ALL SELECT OTB.OT_TYPE_CODE AS CODE_NO FROM ESS_APPLY_OT_BATCH OTB) AR,
             SY_GLOBAL_NAME SY WHERE AR.CODE_NO = SY.NO AND SY.LANGUAGE = 'zh' 
             AND AR.CODE_NO NOT IN('21','31','218112')
             ORDER BY SY.CONTENT
			]]>
	</select>


	<select id="getArDeptShiftList" parameterClass="linkMap"
		resultClass="linkMap" remapResults="true">
			<![CDATA[
			    
				select he.empid,
				       he.local_name,
				       hdn.content deptname,
				       sy.content shift_name,
				       to_char(to_date(ar.ar_date_str,'yyyy-MM-dd'),'yyyy-MM-dd') ar_date_str
				  from ar_schedule_c11    ar,
				       hr_employee        he,
				       hr_department      hd,
				       hr_department_name hdn,
				       sy_global_name     sy
				 where ar.person_id = he.person_id
				   and he.deptno = hd.deptno
				   and hd.deptno = hdn.deptno
				   and hdn.language = #LANGUAGE:VARCHAR#
				   and ar.shift_no = sy.no(+)
				   and sy.language = #LANGUAGE:VARCHAR#
				   and substr(ar.ar_date_str, 1, 7) = #AR_MONTH:VARCHAR#
				      
				   and EXISTS
				 (SELECT *
				          FROM HR_DEPARTMENT
				         WHERE HR_DEPARTMENT.DEPTNO = he.DEPTNO
				         START WITH HR_DEPARTMENT.DEPTNO = #DEPTNO:VARCHAR#
				        
				        CONNECT BY PRIOR HR_DEPARTMENT.DEPTNO = HR_DEPARTMENT.PARENT_DEPT_NO)
				 order by he.empid, ar.ar_date_str

			]]>
	</select>

	<select id="getArCompanyCalendarShiftList" parameterClass="linkMap"
		resultClass="linkMap" remapResults="true">
			<![CDATA[
				SELECT AC.DDATE_STR, GET_GLOBAL_NAME(AC.SHIFT_NO,#LANGUAGE:VARCHAR#) SHIFT_NAME
				  FROM AR_CALENDER AC
				 WHERE AC.DDATE BETWEEN GET_AR_START_DATE(REPLACE(#AR_MONTH:VARCHAR#,'-',''), #CPNY_ID:VARCHAR#, '23692') AND
				       GET_AR_END_DATE(REPLACE(#AR_MONTH:VARCHAR#,'-',''), #CPNY_ID:VARCHAR#, '23692')
				   AND AC.CPNY_ID = #CPNY_ID:VARCHAR#
			]]>
	</select>






