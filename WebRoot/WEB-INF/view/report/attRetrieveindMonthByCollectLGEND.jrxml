				<textFieldExpression   class="java.lang.String"><![CDATA[$P{ATT_MON}.substring( 0, 4 )+"年"+$P{ATT_MON}.substring( 4, 6 )]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="false" pattern="" isBlankWhenNull="false" evaluationTime="Now" hyperlinkType="None"  hyperlinkTarget="Self" >
