               SUM(QTJQ) QTJQ,
               SUM(ATT.SICK_LEAVE_HOUR) SICK_LEAVE_HOUR,
               SUM(ATT.SICK_LEAVE_HOUR_DAY) SICK_LEAVE_HOUR_DAY,
               SUM(ATT.PRIVATE_LEAVE_HOUR) PRIVATE_LEAVE_HOUR,
               SUM(ATT.WED_LEAV_DAY) WED_LEAV_DAY,
               SUM(ATT.YEAR_MON_DAY) YEAR_MON_DAY,
               SUM(ATT.COMPANY_LEAVE) COMPANY_LEAVE,
               SUM(ATT.LATE_HOUR) LATE_HOUR,
               SUM(ATT.EARLY_LEAV_HOUR) EARLY_LEAV_HOUR
          FROM (SELECT H.PERSON_ID,
                       E.empid,
                       E.LOCAL_NAME CN_NM,
		       E.EMP_TYPE_CODE,
                       T.ORG_NAME_LOCAL CN_ORG_NM,
                       E.DEPTNO,
                       SUBSTR(AR_DATE_STR, 9, 2)|| row_number() over (partition by H.PERSON_ID,H.AR_DATE_STR order by H.CREATE_DATE,H.ITEM_NO) ATT_DAY,
                         DECODE(ITEM_NO,
                            '278598','TZ',--'特殊加班(周末)'
                            '278599','TF',--'特殊加班(法定日)'
                            '218253','TJ',--'探亲假'
                            '218200','P',--'陪护假'
                            '218198','TO',--'特殊加班'
                            '218411','WX',--'无薪休息日'
                            '218412','J',--'公司纪念日'
                            '141440','R',--'休息'
                            '141441','T',--'迟到'
                            '141444','PN',--'平时加班(付薪)'
                            '141450','PO',--'社外周末加班(付薪)'
                            '141458','ML',--'婚假'
                            '141463','LC',--'流产假'
                            '141464','S',--'病假'
                            '141465','D',--'工伤假'
                            '141466','V',--'妇女节假'
                            '141467','Q',--'青年节假'
                            '141468','O',--'外出'
                            '141469','U',--'出差'
                            '141439','A',--'正常出勤'
                            '141459','SJ',--'丧假'
                            '141460','CM',--'产期检查假'
                            '141445','PW',--'周末加班(付薪)'
                            '141442','E',--'早退'
                            '141443','K',--'旷工'
                            '141449','SP',--'社外平时加班(付薪)'
                            '141454','CL',--'事假'
                            '141457','WV',--'福利年假'
                            '141461','CJ',--'产假'
                            '141462','NL',--'哺乳假'
                            '217876','JX',--'季节休假'
                            '141446','PH',--'法定假加班(付薪)'
                            '141452','RW',--'周末加班(调休)'
                            '141453','RO',--'社外周末加班(调休)'
                            '141455','PL',--'加班调休'
                            '217878','PJ',--'陪产假'
                            '217874','PZ',--'周末夜班加班(付薪)'
                            '217875','PD',--'法定假夜班加班(付薪)'
                            '141451','SF',--'社外法定假加班(付薪)'
                            '141456','N',---'法定年假'
                            '218125','GD',--'公假'
                            '218255','Y',--'因私外出'
                            '218126','PX',---'培训'
                            '218254','JJ',--'节育手术假'
                            '218349','TC',--'停产假'
                            ''           
                        ) as CODE,
                           --DECODE(SUBSTR(ITEM_NO, 1, 2),'ZA',OT_HOUR,'ZLR1',OT_HOUR,'ZLT0',0,'ZH',WORK_HOUR + ETC_HOUR,0) AS SOM_OT_HOUR, --加班时间
                      DECODE(H.Item_No,'141444',H.QUANTITY,0)+DECODE(H.ITEM_NO,'278598',H.QUANTITY,0)+DECODE(H.ITEM_NO,'218198',H.QUANTITY,0)
                      +DECODE(H.ITEM_NO,'141445',H.QUANTITY,0)+DECODE(H.ITEM_NO,'141450',H.QUANTITY,0)+DECODE(H.ITEM_NO,'217874',H.QUANTITY,0)+DECODE(H.ITEM_NO,'141446',H.QUANTITY,0)
                      +DECODE(H.ITEM_NO,'141449',H.QUANTITY,0)+DECODE(H.ITEM_NO,'217874',H.QUANTITY,0)
                      +DECODE(H.ITEM_NO,'141451',H.QUANTITY,0)+DECODE(H.ITEM_NO,'217875',H.QUANTITY,0) 
                      +DECODE(H.ITEM_NO,'141452',H.QUANTITY,0)+DECODE(H.ITEM_NO,'141453',H.QUANTITY,0) 
                      AS SOM_OT_HOUR, --加班时间
                     DECODE(H.ITEM_NO,'141439',to_number(h.quantity)/8,0) AS WORK_DAY, --正常出勤天数
                     --OT_HOUR AS OT_HOUR, --平时加班(H)
                      DECODE(H.ITEM_NO,'141444',H.Quantity,'218198',H.Quantity,'141449', H.Quantity,0) AS OT_HOUR, --平时加班(H)

                     DECODE(H.ITEM_NO,'278598',H.Quantity,'141445',H.Quantity,'141450',H.Quantity,
                     '217874',H.Quantity,0) AS WEEK_WORK_HOUR, --周末加班时 '141452',H.Quantity, '141453',H.Quantity,调休

                     DECODE(H.ITEM_NO,'141446',H.QUANTITY,'217875',H.QUANTITY,'141451',H.QUANTITY,'278599',H.QUANTITY,0) AS GOVER_WORK_HOUR, --法定加班时
                     DECODE(H.ITEM_NO,'18135', to_number(h.quantity)/8,'141452',to_number(h.quantity)/8, '141453',to_number(h.quantity)/8, 0) AS EXTRA_HOLIDAY, --加班调休天     

                     0 AS YEGANG_CNT,--夜岗
                     DECODE(H.ITEM_NO, '141469', to_number(h.quantity)/8, 0) AS CCTS,--出差天数
                     DECODE(H.ITEM_NO, '141465', to_number(h.quantity)/8, 0) AS COM_WOUND, --工伤 天
                     DECODE(H.ITEM_NO,'141459',to_number(h.quantity)/8,0) AS PRI_FUNERAL,--丧假 天
                     DECODE(H.ITEM_NO, '141461', to_number(h.quantity)/8, 0) AS PRI_MATE, --产假 天
                     DECODE(H.ITEM_NO, 'ZLR0', to_number(h.quantity)/8, 0) AS PRI_REST, --休职/待岗 天
                     DECODE(H.ITEM_NO,'141443',to_number(h.quantity),0) AS PRI_ABSEN,--旷工 天
                     --DECODE(NIGHT_WORK_YN, 'Y', 1, 0) AS NIGT, --夜班/夜岗 天
                     
			CASE WHEN H.shift_no = '218090' AND H.ITEM_NO='141439' THEN 1	ELSE 0 END AS NIGT,--夜班/夜岗 天
                     --DECODE(ITEM_NO, '141464', ETC_HOUR, 0) AS SICK_LEAVE_HOUR, --病假时
                     decode(h.item_no,'141464',to_number(h.quantity)/8,0) AS SICK_LEAVE_HOUR, --病假时
                     DECODE(H.ITEM_NO, 'ZLS1', to_number(h.quantity)/8, 0) AS SICK_LEAVE_HOUR_DAY, --长期病假天
                     DECODE(H.ITEM_NO, '141454', NVL(QUANTITY, 0), 0) AS PRIVATE_LEAVE_HOUR, --事假时
                     DECODE(H.ITEM_NO, '141458', to_number(h.quantity)/8, 0) AS WED_LEAV_DAY, --婚假
                     DECODE(H.ITEM_NO,'141456',to_number(h.quantity)/8,'141457',to_number(h.quantity)/8,0) AS YEAR_MON_DAY,--年假和月假 法定年假，福利年假 8小时算一天
                     --DECODE(ITEM_NO, 'ZLT0', ETC_HOUR, 0) AS COMPANY_LEAVE, --休业   
                     0 AS COMPANY_LEAVE, --休业       
                     DECODE(H.ITEM_NO,'141466/141467',to_number(h.quantity)/8,'141465',to_number(h.quantity)/8,'141459',to_number(h.quantity)/8,'218253',to_number(h.quantity)/8,'141461',to_number(h.quantity)/8,
                     '217878',to_number(h.quantity)/8,'141462',to_number(h.quantity)/8,'141460',to_number(h.quantity)/8,'141463',to_number(h.quantity)/8,'ZLM5',to_number(h.quantity)/8,'218125',to_number(h.quantity)/8,0) QTJQ,--其它假别
                     decode(h.item_no,'141441',h.quantity,0) AS LATE_HOUR, --迟到分钟 单位为分钟
                     decode(h.item_no,'141442',h.quantity,0) AS EARLY_LEAV_HOUR --早退分钟
                  
                FROM AR_DETAIL_$P!{SUBSD_CD} H,HR_EMPLOYEE E,HR_DEPARTMENT T
               WHERE H.PERSON_ID = E.PERSON_ID
                 AND E.DEPTNO = T.DEPTNO

                 and h.ar_month_str=$P{ATT_MON}
                 AND E.EMP_TYPE_CODE IN
                     ( SELECT EMP_TYPE_CODE CODE_NO
                             FROM AR_SUPERVISOR_EMPTYPE_INFO P,HR_JOB_TYPE_SETUP HP
                             WHERE P.EMP_TYPE_CODE = HP.JOBTYPE_NO
                             AND HP.CPNY_ID = $P{SUBSD_CD}
                             AND P.PERSON_ID = $P{PERSON_ID_JOB}
                             AND (DECODE($P{JOB_TP},'211807',0,1)=0 
                             OR CASE WHEN $P{SUBSD_CD}='LGEND' THEN HP.JOBTYPE_NO ELSE HP.JOBTYPE_GROUP_NO END  = $P{JOB_TP})
			)
                              
                 AND T.DEPTNO IN (SELECT DEPTNO
                        FROM HR_DEPARTMENT
                       WHERE CPNY_ID =$P{SUBSD_CD}
                      CONNECT BY PRIOR DEPTNO = PARENT_DEPT_NO
                       START WITH DEPTNO =$P{ORG_ID}
		      AND E.DEPTNO IN (SELECT DEPTNO FROM AR_SUPERVISOR_INFO WHERE PERSON_ID = $P{PERSON_ID_JOB}))
               ORDER BY ATT_DAY) ATT
         GROUP BY ATT.DEPTNO, ATT.EMPID) B order by b.CN_ORG_NM) C]]></queryString>

	<field name="NO" class="java.math.BigDecimal"/>
	<field name="SUBSD_CD" class="java.lang.String"/>
	<field name="EMPNO" class="java.lang.String"/>
	<field name="EMP_NAME" class="java.lang.String"/>
